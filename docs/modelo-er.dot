digraph ModeloER {
  graph [rankdir=LR, nodesep=0.6, ranksep=1.2, fontname="Helvetica", bgcolor="white", pad=0.3];
  node [shape=plain, fontname="Helvetica", fontsize=11];
  edge [dir=both, color="#33414e", fontname="Helvetica", fontsize=10, fontcolor="#33414e", penwidth=1.2];
  USUARIO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a96a3"><TR><TD COLSPAN="3" BGCOLOR="#1F4E79"><FONT COLOR="white"><B>USUARIO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#5c6670">PK</FONT></TD><TD ALIGN="LEFT"><B><U>id_usuario</U></B></TD><TD ALIGN="LEFT"><FONT COLOR="#5c6670">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6670">varchar(120)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#5c6670">UQ</FONT></TD><TD ALIGN="LEFT">correo</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6670">varchar(256)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">hash_contrasena</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6670">text</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#5c6670">CK</FONT></TD><TD ALIGN="LEFT">rol</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6670">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">activo</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6670">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">fecha_registro</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6670">timestamptz</FONT></TD></TR></TABLE>>];
  CATEGORIA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a96a3"><TR><TD COLSPAN="3" BGCOLOR="#1F4E79"><FONT COLOR="white"><B>CATEGORIA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#5c6670">PK</FONT></TD><TD ALIGN="LEFT"><B><U>id_categoria</U></B></TD><TD ALIGN="LEFT"><FONT COLOR="#5c6670">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#5c6670">UQ</FONT></TD><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6670">varchar(60)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">descripcion</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6670">varchar(250)</FONT></TD></TR></TABLE>>];
  SENA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a96a3"><TR><TD COLSPAN="3" BGCOLOR="#1F4E79"><FONT COLOR="white"><B>SENA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#5c6670">PK</FONT></TD><TD ALIGN="LEFT"><B><U>id_sena</U></B></TD><TD ALIGN="LEFT"><FONT COLOR="#5c6670">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#5c6670">UQ</FONT></TD><TD ALIGN="LEFT">palabra</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6670">varchar(60)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#5c6670">FK</FONT></TD><TD ALIGN="LEFT"><I>id_categoria</I></TD><TD ALIGN="LEFT"><FONT COLOR="#5c6670">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#5c6670">CK</FONT></TD><TD ALIGN="LEFT">num_manos</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6670">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">recurso_visual_url</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6670">varchar(500) NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">activa</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6670">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">fecha_registro</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6670">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#5c6670">FK</FONT></TD><TD ALIGN="LEFT"><I>id_admin_registro</I></TD><TD ALIGN="LEFT"><FONT COLOR="#5c6670">uuid</FONT></TD></TR></TABLE>>];
  REFERENCIA_GEOMETRICA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a96a3"><TR><TD COLSPAN="3" BGCOLOR="#1F4E79"><FONT COLOR="white"><B>REFERENCIA_GEOMETRICA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#5c6670">PK</FONT></TD><TD ALIGN="LEFT"><B><U>id_referencia</U></B></TD><TD ALIGN="LEFT"><FONT COLOR="#5c6670">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#5c6670">FK</FONT></TD><TD ALIGN="LEFT"><I>id_sena</I></TD><TD ALIGN="LEFT"><FONT COLOR="#5c6670">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">distancias</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6670">jsonb</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">angulos</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6670">jsonb</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">puntos_normalizados</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6670">jsonb</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#5c6670">CK</FONT></TD><TD ALIGN="LEFT">num_muestras</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6670">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">fecha_captura</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6670">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#5c6670">FK</FONT></TD><TD ALIGN="LEFT"><I>id_admin</I></TD><TD ALIGN="LEFT"><FONT COLOR="#5c6670">uuid</FONT></TD></TR></TABLE>>];
  CONSULTA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a96a3"><TR><TD COLSPAN="3" BGCOLOR="#1F4E79"><FONT COLOR="white"><B>CONSULTA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#5c6670">PK</FONT></TD><TD ALIGN="LEFT"><B><U>id_consulta</U></B></TD><TD ALIGN="LEFT"><FONT COLOR="#5c6670">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#5c6670">FK</FONT></TD><TD ALIGN="LEFT"><I>id_medico</I></TD><TD ALIGN="LEFT"><FONT COLOR="#5c6670">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">fecha_consulta</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6670">date</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">hora_inicio</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6670">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">hora_fin</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6670">timestamptz NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#5c6670">CK</FONT></TD><TD ALIGN="LEFT">estado</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6670">varchar(20)</FONT></TD></TR></TABLE>>];
  TRADUCCION_REGISTRADA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a96a3"><TR><TD COLSPAN="3" BGCOLOR="#1F4E79"><FONT COLOR="white"><B>TRADUCCION_REGISTRADA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#5c6670">PK</FONT></TD><TD ALIGN="LEFT"><B><U>id_traduccion</U></B></TD><TD ALIGN="LEFT"><FONT COLOR="#5c6670">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#5c6670">FK</FONT></TD><TD ALIGN="LEFT"><I>id_consulta</I></TD><TD ALIGN="LEFT"><FONT COLOR="#5c6670">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#5c6670">FK</FONT></TD><TD ALIGN="LEFT"><I>id_sena</I></TD><TD ALIGN="LEFT"><FONT COLOR="#5c6670">uuid NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">palabra</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6670">varchar(60) NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">hora_exacta</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6670">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#5c6670">CK</FONT></TD><TD ALIGN="LEFT">puntaje_similitud</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6670">numeric(5,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#5c6670">CK</FONT></TD><TD ALIGN="LEFT">nivel_certeza</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6670">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#5c6670">CK</FONT></TD><TD ALIGN="LEFT">estado</TD><TD ALIGN="LEFT"><FONT COLOR="#5c6670">varchar(20)</FONT></TD></TR></TABLE>>];
  USUARIO -> CONSULTA [arrowtail=teetee, arrowhead=crowodot, label="  atiende  "];
  CONSULTA -> TRADUCCION_REGISTRADA [arrowtail=teetee, arrowhead=crowodot, label="  contiene  "];
  CATEGORIA -> SENA [arrowtail=teetee, arrowhead=crowodot, label="  agrupa  "];
  SENA -> REFERENCIA_GEOMETRICA [arrowtail=teetee, arrowhead=crowtee, label="  se describe por  "];
  SENA -> TRADUCCION_REGISTRADA [arrowtail=teeodot, arrowhead=crowodot, label="  se reconoce como  "];
  USUARIO -> SENA [arrowtail=teetee, arrowhead=crowodot, label="  registra  "];
  USUARIO -> REFERENCIA_GEOMETRICA [arrowtail=teetee, arrowhead=crowodot, label="  captura  "];
  { rank=same; USUARIO; CATEGORIA; }
  { rank=same; CONSULTA; SENA; }
}
